# ════════════════════════════════════════════════════════════
#  Statusline 設定檔 — 直接改 value 即可，存檔後下次刷新生效
#  （不必跑 /statusline-style，省 token）
# ════════════════════════════════════════════════════════════
#
#  bar_style：能量條樣式（配色固定 綠→橙→黃→紅，越滿越警示）
#
#  可選值：
#    segmented   ▕▰▰▰▱▏   分段槽（預設）
#    solid       ▐██░▌    實心條 + 外框
#    dots        ●●●○○    圓點
#    squares     ■■■□□    粗方塊
#    braille     ▕⣿⣿⣀▏   點陣粒子
#    gradient    ▐██▓▒░▌  漸層消散
#
#  改法：把下面這行等號後面換成上面任一個值即可
# ────────────────────────────────────────────────────────────

bar_style=segmented
